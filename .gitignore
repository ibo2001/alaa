.claude/settings.local.json
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# serwist (generated at build)
public/sw.js
public/sw.js.map
public/swe-worker*.js
public/swe-worker*.js.map

# playwright
/test-results/
/playwright-report/
/playwright/.cache/
!.env.example

# eval images are local until their licenses are documented
/eval/images/*
!/eval/images/README.md
!/eval/images/labels.json
!/eval/images/SOURCES.md

# User-testing responses (fetched by scripts/study-results.ts); never committed
/user-testing-private/

# Challenge deck (official template with partner logos): delivered, not committed
/docs/presentation/

# demo video build outputs (recordings, voice, renders)
/video/public/clips/
/video/public/voice/
/video/out/
/video/node_modules/

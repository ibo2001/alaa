# Copy to .env.local and fill in. Never commit real values.

# Vision provider: "anthropic" (default) or "stub" (no network; for tests/demo fallback)
VISION_PROVIDER=anthropic
# Model id used by the Anthropic provider
VISION_MODEL=
ANTHROPIC_API_KEY=

# Max recognitions per device per day (raised for the judging demo)
DAILY_LIMIT=

# Error reports ("Report an error") are filed as GitHub Issues
GITHUB_ISSUES_TOKEN=
GITHUB_REPO=

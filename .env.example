# Copy to .env.local and fill in. Never commit real values.

# Vision provider: "anthropic" (default) or "stub" (no network; for tests/demo fallback)
VISION_PROVIDER=anthropic
# Model id used by the Anthropic provider (the live demo and the evaluation use claude-haiku-4-5-20251001)
VISION_MODEL=
ANTHROPIC_API_KEY=

# Max recognitions per device per day (raised for the judging demo)
DAILY_LIMIT=

# Planned /api/report (not read yet; "Report an error" opens a prefilled GitHub issue link today)
GITHUB_ISSUES_TOKEN=
GITHUB_REPO=
